{
  "name": "@nexus-battle-vi/notifications",
  "version": "0.1.0",
  "private": true,
  "description": "Worker de notificaciones transaccionales de Nexus Battles VI (bounded context Notifications).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.17.0",
  "main": "dist/worker.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/worker.ts",
    "build": "npm run typecheck && node node_modules/typescript7/bin/tsc --project tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/worker.js",
    "start:prod": "node dist/worker.js",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1123.0",
    "nodemailer": "9.0.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.4.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.4.2",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "typescript7": "npm:typescript@7.0.2"
  }
}
