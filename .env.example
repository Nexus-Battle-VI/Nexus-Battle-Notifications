# Configuracion del worker de notificaciones.
# Se copia a `.env` para desarrollo local. `.env` esta ignorado por Git.
# Este archivo no contiene ni debe contener secretos reales.

# --- Servicio -------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=nexus-battle-notifications
SERVICE_VERSION=0.1.0
LOG_LEVEL=info
HEALTH_PORT=3001

# Ingesta HTTP (ADR-006): recibe de Account las solicitudes de notificacion.
# Apagada por defecto. No publicar este puerto al anfitrion: se alcanza solo
# desde la red interna de Docker.
INGEST_ENABLED=false
INGEST_PORT=3002
# Opcional. Si se define, toda peticion debe traer la cabecera x-ingest-secret.
INGEST_SHARED_SECRET=

# --- Correo ---------------------------------------------------------------
# fake: retiene los mensajes en memoria y no envia nada. Es el valor por defecto.
# smtp: entrega contra un servidor SMTP. En local se usa Mailpit.
EMAIL_DRIVER=fake
EMAIL_FROM=no-reply@nexus-battles.local
SMTP_HOST=localhost
SMTP_PORT=1025
# Obligatorios para Gmail. No commitear SMTP_PASS.
SMTP_USER=
SMTP_PASS=

# --- Cola general (notificaciones transaccionales) -------------------------
# memory: cola en proceso, suficiente para desarrollo y pruebas.
# sqs: requiere ADR-006 aprobado. QUEUE_URL y AWS_REGION pasan a ser obligatorios.
QUEUE_DRIVER=memory
QUEUE_URL=
AWS_REGION=

# --- Cola dedicada de catalog.product.created (ADR-017, Infrastructure#93) -
# INDEPENDIENTE de QUEUE_DRIVER/QUEUE_URL de arriba: ADR-017 aprobo SQS
# unicamente para este evento, no una migracion de la cola general. Activar
# CATALOG_QUEUE_DRIVER=sqs NO exige QUEUE_URL, y viceversa.
#
# memory: cola en proceso (desarrollo, pruebas, o mientras la cola real de
#         Infrastructure#93 no este desplegada).
# sqs:    exige CATALOG_QUEUE_URL y AWS_REGION (arriba).
CATALOG_QUEUE_DRIVER=memory
# URL de la cola dedicada. La rellena Terraform (Infrastructure#93,
# infra/modules/catalog_events_queue) en un entorno real; vacia en local.
CATALOG_QUEUE_URL=

# --- Consumo y reintentos -------------------------------------------------
POLL_INTERVAL_MS=1000
BATCH_SIZE=10
MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=60000
IDEMPOTENCY_TTL_MS=86400000

# Confirmacion de compra desde el outbox de Commerce (solo red interna).
PURCHASE_HTTP_ENABLED=false
PURCHASE_HTTP_PORT=3003
PURCHASE_INBOX_DRIVER=mongo
MONGO_URL=
MONGO_DB_NAME=notifications

# Secreto compartido para llamadas internas firmadas.
# No colocar secretos reales en este archivo.
INTERNAL_SERVICE_AUTH_SECRET=

# --- HU-38: notificaciones de catalogo in-app + banner ---------------------
# Apagado por defecto. Requiere MONGO_URL (arriba) y un pool de Cognito.
CATALOG_NOTIFICATIONS_HTTP_ENABLED=false
CATALOG_NOTIFICATIONS_HTTP_PORT=3004
# mongo: persistencia real. memory: solo fuera de produccion.
CATALOG_NOTIFICATIONS_REPOSITORY_DRIVER=mongo
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Cola dedicada de los cuatro eventos de ciclo de vida -suspended/
# reactivated/inventory.adjusted/premium.configured- (ADR-018, Accepted,
# Infrastructure#95). INDEPENDIENTE de QUEUE_DRIVER y de CATALOG_QUEUE_DRIVER:
# activar CATALOG_LIFECYCLE_QUEUE_DRIVER=sqs NO exige ninguno de los otros
# dos, y viceversa.
#
# memory: cola en proceso (desarrollo, pruebas, o mientras la cola real de
#         Infrastructure#95 no este desplegada).
# sqs:    exige CATALOG_LIFECYCLE_QUEUE_URL y AWS_REGION (arriba).
CATALOG_LIFECYCLE_QUEUE_DRIVER=memory

# URL de la cola dedicada. La rellena Terraform (Infrastructure#95,
# infra/modules/catalog_lifecycle_events_queue) en un entorno real; vacia en
# local.
CATALOG_LIFECYCLE_QUEUE_URL=

# --- Cola dedicada auction.settled.v1 (HU-65.6) ----------------------------
# memory: sin polling remoto. sqs: requiere URL y AWS_REGION.
AUCTION_SETTLEMENT_QUEUE_DRIVER=memory
AUCTION_SETTLEMENT_QUEUE_URL=

# Resolucion real de destinatarios de suspension/reactivacion contra
# Player-Inventory (Nexus-Battle-Player-Inventory#23). Ambas variables son
# opcionales: si falta cualquiera de las dos -incluido INTERNAL_SERVICE_AUTH_SECRET
# de arriba, que se reutiliza para firmar esta llamada saliente-, la
# composicion cae en UnavailableProductOwnersResolver (fail closed: nunca se
# inventa un destinatario ni se usa audiencia GLOBAL como sustituto).
PLAYER_INVENTORY_BASE_URL=
PLAYER_INVENTORY_TIMEOUT_MS=2000

# --- HU-63.5: notificacion al postor superado -----------------------------
# Reutiliza la persistencia de notificaciones in-app de HU-38 porque Auction
# conoce al jugador desplazado por playerId, no por correo.
#
# Por eso requiere:
# CATALOG_NOTIFICATIONS_HTTP_ENABLED=true
#
# Este puerto debe exponerse unicamente dentro de la red interna.
AUCTION_OUTBID_HTTP_ENABLED=false
AUCTION_OUTBID_HTTP_PORT=3005

# La llamada Auction -> Notifications usa INTERNAL_SERVICE_AUTH_SECRET.
