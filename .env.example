# Configuracion del worker de notificaciones.
# Se copia a `.env` para desarrollo local. `.env` esta ignorado por Git.
# Este archivo no contiene ni debe contener secretos reales.

# --- Servicio -------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=nexus-battle-notifications
SERVICE_VERSION=0.1.0
LOG_LEVEL=info
HEALTH_PORT=3001

# --- Correo ---------------------------------------------------------------
# fake: retiene los mensajes en memoria y no envia nada. Es el valor por defecto.
# smtp: entrega contra un servidor SMTP. En local se usa Mailpit.
EMAIL_DRIVER=fake
EMAIL_FROM=no-reply@nexus-battles.local
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Cola -----------------------------------------------------------------
# memory: cola en proceso, suficiente para desarrollo y pruebas.
# sqs: requiere ADR-006 aprobado. QUEUE_URL y AWS_REGION pasan a ser obligatorios.
QUEUE_DRIVER=memory
QUEUE_URL=
AWS_REGION=

# --- Consumo y reintentos -------------------------------------------------
POLL_INTERVAL_MS=1000
BATCH_SIZE=10
MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=60000
IDEMPOTENCY_TTL_MS=86400000
